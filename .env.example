# Copy to .env; replace credentials and never commit real secrets.
NODE_ENV=development
LOG_LEVEL=info
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://squad:squad_local_only@localhost:55433/squad?schema=public
REDIS_URL=redis://localhost:6379
POSTGRES_USER=squad
POSTGRES_PASSWORD=squad_local_only
POSTGRES_DB=squad
POSTGRES_PORT=55433
REDIS_PORT=6379

# BotFather token and bot username (without @). Use your own development bot.
BOT_TOKEN=123456789:replace_with_a_real_bot_token
BOT_USERNAME=squad_dev_bot
# One HTTPS tunnel to Vite :5173; Vite proxies /api to the API :3000.
MINIAPP_URL=https://replace-with-your-tunnel.example
PUBLIC_API_URL=https://replace-with-your-tunnel.example
MINIAPP_ORIGIN=https://replace-with-your-tunnel.example
# Same origin is recommended. Leave blank to use Vite's /api proxy.
VITE_API_BASE_URL=
# Set to the hostname of your ngrok or Cloudflare URL; never use allow-all.
DEV_TUNNEL_HOST=replace-with-your-tunnel.example
SESSION_TTL_SECONDS=3600
TELEGRAM_AUTH_MAX_AGE_SECONDS=300
STEAM_LINK_TTL_SECONDS=600
AGE_MINIMUM=18
RULES_VERSION=2026-10-07
# false or explicit trusted proxy IP/CIDR list. Never trust all forwarded headers.
TRUST_PROXY=false

# Not needed for Steam OpenID in M2; used for cached stats in M3.
STEAM_WEB_API_KEY=
FACEIT_API_KEY=
REQUESTS_PER_DAY=10
REQUEST_TTL_DAYS=7
REQUESTS_RATE_LIMIT_PER_MINUTE=60
NOTIFICATION_CONCURRENCY=3
NOTIFICATION_RATE_LIMIT_PER_SECOND=25
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_BACKOFF_MS=1000
TELEGRAM_CONTACT_TIMEOUT_MS=5000
# Feed access requires a published CS2 profile by default.
FEED_REQUIRES_PUBLISHED_PROFILE=true
FEED_RATE_LIMIT_PER_MINUTE=60
# Synthetic tools additionally require ALLOW_SYNTHETIC_SEED=1 and a loopback *_dev/*_test DB.
# Do not enable this on a running application/server environment.
ALLOW_SYNTHETIC_SEED=0
STATS_REFRESH_HOURS=6
STATS_WORKER_CONCURRENCY=3
STATS_MANUAL_COOLDOWN_SECONDS=300
# Global spacing per outgoing provider request (shared across API replicas).
STATS_STEAM_INTERVAL_MS=1000
STATS_FACEIT_INTERVAL_MS=1000
ADMIN_TELEGRAM_IDS=
# Comma-separated numeric Telegram IDs, never usernames. Empty disables admins.
SUPPORT_CONTACT=
# Support accepts @username or https://t.me/username; empty is allowed.
REPORTS_PER_DAY=10
REPORTS_AUTO_HIDE_THRESHOLD=3
REPORTS_RATE_LIMIT_PER_MINUTE=10
REPORT_RETENTION_DAYS=180
# Host-side backup/smoke scripts, not app runtime settings.
BACKUP_KEEP=14
BACKUP_DIR=./backups
SMOKE_ORIGIN=http://127.0.0.1:8088
