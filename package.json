{
  "name": "squad-telegram",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "lint": "eslint \"apps/**/*.{ts,tsx}\" \"packages/**/*.ts\" --max-warnings 0",
    "dev": "pnpm --filter @squad/shared build && dotenv -e .env -- pnpm --parallel --filter @squad/api --filter @squad/bot --filter @squad/miniapp dev",
    "dev:api": "pnpm --filter @squad/shared build && dotenv -e .env -- pnpm --filter @squad/api dev",
    "dev:miniapp": "pnpm --filter @squad/shared build && dotenv -e .env -- pnpm --filter @squad/miniapp dev",
    "build": "pnpm --filter @squad/shared build && pnpm -r --filter @squad/api --filter @squad/bot --filter @squad/miniapp build",
    "typecheck": "pnpm --filter @squad/shared build && pnpm -r typecheck",
    "test": "pnpm --filter @squad/shared build && pnpm -r --if-present test && pnpm test:ops",
    "test:ops": "node --test scripts/test/*.test.mjs",
    "check:headers": "node scripts/check-security-headers.mjs",
    "test:integration": "pnpm --filter @squad/shared build && pnpm --filter @squad/api test:integration",
    "db:generate": "pnpm --filter @squad/api db:generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @squad/api db:migrate",
    "db:dev": "dotenv -e .env -- pnpm --filter @squad/api db:dev",
    "db:seed": "dotenv -e .env -- pnpm --filter @squad/api db:seed",
    "db:validate": "dotenv -e .env -- pnpm --filter @squad/api db:validate",
    "dev:synthetic:seed": "pnpm --filter @squad/shared build && pnpm --filter @squad/api dev:synthetic:seed",
    "dev:synthetic:cleanup": "pnpm --filter @squad/shared build && pnpm --filter @squad/api dev:synthetic:cleanup",
    "dev:feed:benchmark": "pnpm --filter @squad/shared build && pnpm --filter @squad/api dev:feed:benchmark"
  },
  "pnpm": { "overrides": { "@prisma/config>effect": "~3.20.0" } },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "8",
    "vitest": "^3.2.4"
  }
}
